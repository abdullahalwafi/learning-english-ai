rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'ageGroup']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.ageGroup in ['kids', 'teenagers', 'adults'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        // Only allow updating certain fields while keeping uid stationary
        request.resource.data.uid == resource.data.uid
      );

      match /sessions/{sessionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      request.resource.data.userId == userId &&
                      request.resource.data.keys().hasAll(['userId', 'timestamp', 'persona']);
      }
    }

    match /test/{docId} {
      allow read: if isSignedIn();
    }
  }
}
